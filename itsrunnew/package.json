{
  "name": "itsrunnew",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:smoke:preview": "node scripts/smoke-preview.mjs",
    "test:visual": "node scripts/visual-compare.mjs",
    "validate:tracks": "node scripts/validate-tracks.mjs",
    "collect:availability": "tsx scripts/availability/collect.ts",
    "collect:availability:range": "tsx scripts/availability/collect-range.ts",
    "lint": "vue-tsc --noEmit",
    "deploy:preview:content": "bash scripts/deploy-preview.sh",
    "deployment:summary": "node scripts/deployment-summary.mjs",
    "infra:synth": "npm run build && cdk synth",
    "infra:deploy": "npm run build && cdk deploy --require-approval never --outputs-file cdk-outputs.json",
    "infra:destroy": "cdk destroy",
    "infra:automation:synth": "cdk synth --app \"npx tsx infra/automation-app.ts\"",
    "infra:automation:deploy": "cdk deploy --app \"npx tsx infra/automation-app.ts\" ItsRunPreviewAutomationStack --require-approval never"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "dayjs": "^1.11.18",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.3",
    "vuetify": "^4.1.11"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "aws-cdk": "^2.1138.0",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.4.4",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.62.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.8"
  }
}
